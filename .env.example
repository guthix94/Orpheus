# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Task queue
REDIS_URL=redis://localhost:6379/0

# Anthropic (LLM narrative generation)
ANTHROPIC_API_KEY=sk-ant-...

# Whisper speech-to-text
WHISPER_MODEL_SIZE=base  # tiny/base/small/medium/large-v3

# Demucs source separation
DEMUCS_MODEL=htdemucs  # htdemucs or htdemucs_ft

# File storage
AUDIO_STORAGE_PATH=./storage/audio
SCORES_PATH=./scores/data

# Email (optional, for parent communications)
SENDGRID_API_KEY=SG...
